# ============================================================
# SDE -> AI Engineer Course - Environment Configuration
# Copy to .env and fill in what you have. EVERYTHING IS OPTIONAL:
# without keys, all scripts degrade gracefully (clear hint + exit 0).
#
# TIP: you can also just copy the repo-root .env (../.env) which already
# holds a working YOLO_AUTO_API_KEY. shared/config.py loads both.
#
# LLM priority: OPENAI_API_KEY > YOLO_AUTO_API_KEY > Ollama (local)
# ============================================================

# --- Cloud LLM option 1: OpenAI (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cloud LLM option 2: Yolo-Auto (OpenAI-compatible, recommended here) ---
# Docs: https://yolo-auto.com  |  Model: qwen3.8-27b (131k context)
YOLO_AUTO_API_KEY=
YOLO_AUTO_BASE_URL=https://yolo-auto.com/v1
YOLO_AUTO_MODEL=qwen3.8-27b

# --- Ollama (local LLM - NOT used on this 8GB laptop) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Embeddings ---
# LOCAL (default, no key needed):
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CLOUD (optional):
# EMBEDDING_PROVIDER=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- LangSmith tracing (optional, production monitoring) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=sde-to-ai-engineer-course
