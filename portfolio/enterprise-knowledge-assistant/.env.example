# --- LLM providers (priority: OpenAI > Yolo-Auto; neither set => degraded mode) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
YOLO_AUTO_API_KEY=yolo_...
YOLO_AUTO_BASE_URL=https://yolo-auto.com/v1
YOLO_AUTO_MODEL=qwen3.8-27b

# --- Vector store ---
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION=knowledge

# --- Embeddings (local, cached on disk) ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# --- Retrieval ---
RRF_K=60
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Semantic cache ---
CACHE_ENABLED=true
CACHE_THRESHOLD=0.92

# --- Guardrails ---
GUARDRAILS_ENABLED=true
