# LLM provider — Yolo-Auto is an OpenAI-compatible cloud endpoint (no local GPU needed)
YOLO_AUTO_API_KEY=your-yolo-auto-key-here
YOLO_AUTO_BASE_URL=https://yolo-auto.com/v1
YOLO_AUTO_MODEL=qwen3.8-27b

# Optional: OpenAI takes priority over Yolo-Auto when set
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Last-resort local LLM (used only if neither key above is set)
# OLLAMA_MODEL=llama3.1

# Local embeddings (cached; no download needed after first run)
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIR=./data/chroma_db

# Agent tuning
REFLECT_CONFIDENCE_THRESHOLD=60
