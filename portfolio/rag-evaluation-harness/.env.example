# Copy to .env and fill in. Everything works WITHOUT any key (heuristic mode).

# --- LLM (optional; needed only for real answer generation + RAGAS metrics) ---
# Option 1: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# Option 2: Yolo-Auto (OpenAI-compatible)
YOLO_AUTO_API_KEY=
YOLO_AUTO_BASE_URL=https://yolo-auto.com/v1
YOLO_AUTO_MODEL=qwen3.8-27b

# --- Embeddings ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Pipeline B reranker: cross | light | off ---
RERANKER=cross

# --- Regression gate tolerance (absolute metric drop allowed) ---
GATE_TOLERANCE=0.05
